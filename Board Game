<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ms. Rocha's Candy Land Race to the Finish!</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;700;800;900&display=swap" rel="stylesheet"><style>
:root{--cream:#fff5db;--brown:#6b3b22;--dark:#3d2114;--pink:#ff5f9d;--blue:#4fb7f2;--green:#31b86b;--yellow:#f6c344;--purple:#9b63d8;--shadow:0 10px 22px #47261238}*{box-sizing:border-box}body{margin:0;font-family:Nunito,system-ui,sans-serif;background:radial-gradient(circle at top left,#fff8e8,#ffe7f1 34%,#fff0ca 70%,#fff7e8);color:var(--dark);min-height:100vh}.app{max-width:1500px;margin:auto;padding:14px}.header{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:#ffffffaa;border:4px solid var(--brown);border-bottom-width:9px;border-radius:24px;box-shadow:var(--shadow);padding:12px 16px}h1{margin:0;font-family:'Fredoka One',cursive;color:var(--pink);text-shadow:2px 3px 0 #fff,4px 5px 0 #6b3b2238;font-size:clamp(24px,3vw,42px)}.top-actions,.class-buttons{display:flex;gap:8px;flex-wrap:wrap}button{border:0;cursor:pointer;font-family:Nunito,sans-serif;font-weight:900;border-radius:14px;padding:9px 12px;color:white;box-shadow:0 5px 0 #40200e38,0 7px 12px #40200e2e}button:active{transform:translateY(2px);box-shadow:0 3px 0 #40200e38}.btn-class{background:var(--blue)}.btn-class.active{background:var(--pink)}.btn-reset{background:#a65b33}.btn-roll{background:var(--green);font-size:18px;width:100%}.btn-apply{background:var(--pink);padding:7px 10px;font-size:13px}.btn-step{background:var(--blue);padding:7px 10px;font-size:13px}.btn-skip{background:var(--yellow);color:#4a2818;padding:7px 10px;font-size:13px}.btn-celebrate{background:var(--purple);width:100%;margin-top:8px}.main{margin-top:14px;display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:14px;align-items:start}.board-wrap{position:relative;background:var(--cream);border:5px solid var(--brown);border-bottom-width:11px;border-radius:26px;overflow:hidden;box-shadow:var(--shadow);user-select:none;touch-action:none}.board-wrap img{display:block;width:100%;height:auto;pointer-events:none}.token{position:absolute;width:clamp(38px,4.6vw,58px);height:clamp(38px,4.6vw,58px);transform:translate(-50%,-50%);border-radius:50%;border:4px solid white;box-shadow:0 5px 10px #0004,inset 0 -6px 0 #0002;display:flex;align-items:center;justify-content:center;color:white;font-family:'Fredoka One',cursive;font-size:clamp(17px,2.3vw,25px);z-index:3;transition:left .45s ease,top .45s ease,transform .12s ease;cursor:grab}.token.dragging{transition:none;cursor:grabbing;z-index:20;transform:translate(-50%,-50%) scale(1.08)}.tag{position:absolute;top:calc(100% + 3px);left:50%;transform:translateX(-50%);white-space:nowrap;background:#ffffffe8;color:var(--dark);border:2px solid var(--brown);border-radius:999px;padding:1px 7px;font:900 11px Nunito;box-shadow:0 2px 4px #0003}.done{outline:5px solid #fff7a8;animation:pulse 1.2s infinite alternate}@keyframes pulse{to{filter:brightness(1.18)}}.panel{display:flex;flex-direction:column;gap:10px}.card{background:#fffaebf2;border:4px solid var(--brown);border-bottom-width:9px;border-radius:22px;box-shadow:var(--shadow);padding:10px}.card h2{margin:0 0 8px;font-family:'Fredoka One',cursive;color:var(--pink);font-size:20px}.die{height:96px;width:96px;border:5px solid var(--brown);border-bottom-width:10px;background:white;border-radius:22px;margin:0 auto 9px;display:grid;place-items:center;font-family:'Fredoka One',cursive;font-size:48px;color:var(--dark);box-shadow:inset 0 -9px 0 #f5c44459,0 7px 12px #0003}.die.rolling{animation:shake .18s linear infinite}@keyframes shake{50%{transform:rotate(5deg)}}.roll-result{text-align:center;font-weight:900;margin:7px 0;color:var(--brown)}.group-row{display:grid;grid-template-columns:22px 1fr;gap:7px;padding:8px 0;border-bottom:2px dotted #6b3b2240}.dot{width:20px;height:20px;border-radius:50%;border:3px solid white;box-shadow:0 2px 4px #0003;margin-top:2px}.group-title{font-weight:900;display:flex;justify-content:space-between;font-size:14px}.group-space{font-size:12px;font-weight:800;color:#7a4a31}.badges,.actions{display:flex;gap:5px;flex-wrap:wrap;margin-top:5px}.badge{font-size:10px;font-weight:900;color:white;background:#a65b33;border-radius:999px;padding:2px 6px}.badge.skip{background:#e05151}.badge.done{background:var(--green)}.guide{font-size:13px;line-height:1.35;font-weight:800}.guide div{margin:3px 0}.guide span{display:inline-block;width:13px;height:13px;border-radius:4px;margin-right:5px;vertical-align:-1px}.leader-row{display:flex;justify-content:space-between;font-weight:900;padding:5px 0;border-bottom:1px solid #6b3b222e;font-size:14px}.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%) translateY(120%);background:var(--brown);color:var(--cream);border:4px solid #fff4c7;border-radius:18px;padding:12px 16px;box-shadow:var(--shadow);font-weight:900;z-index:100;max-width:min(620px,90vw);text-align:center;transition:.25s}.toast.show{transform:translateX(-50%) translateY(0)}.modal-backdrop{position:fixed;inset:0;background:#32190c73;display:none;align-items:center;justify-content:center;padding:20px;z-index:120}.modal-backdrop.show{display:flex}.modal{background:var(--cream);border:5px solid var(--brown);border-bottom-width:12px;border-radius:28px;box-shadow:var(--shadow);width:min(460px,94vw);padding:22px;text-align:center}.modal h3{font-family:'Fredoka One',cursive;color:var(--pink);font-size:30px;margin:0 0 8px}.modal p{font-weight:900;font-size:18px;margin:0 0 18px}.modal button{background:var(--green)}@media(max-width:950px){.main{grid-template-columns:1fr}.panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.card:first-child{grid-column:1/-1}}@media(max-width:620px){.panel{display:flex}.header{justify-content:center;text-align:center}.app{padding:8px}.token .tag{font-size:9px}}
</style></head><body><div class="app"><header class="header"><h1>Ms. Rocha's Candy Land Race to the Finish!</h1><div class="top-actions"><div class="class-buttons"><button class="btn-class active" data-class="7th">7th Grade</button><button class="btn-class" data-class="6th">6th Grade</button></div><button class="btn-reset" id="resetBtn">Reset Current Class</button></div></header><main class="main"><section class="board-wrap" id="boardWrap"><img alt="Candy Land style board game" src="data:image/png;base64,"><div id="tokensLayer"></div></section><aside class="panel"><section class="card"><h2>Die</h2><div class="die" id="die" role="button" tabindex="0">1</div><button class="btn-roll" id="rollBtn">ROLL</button><div class="roll-result" id="rollResult">Roll to begin.</div></section><section class="card"><h2>Groups</h2><div id="groupsPanel"></div><button class="btn-celebrate" id="celebrateBtn" style="display:none">Celebrate Winner</button></section><section class="card"><h2>Space Guide</h2><div class="guide"><div><span style="background:#31b86b"></span>Move ahead spaces help you advance.</div><div><span style="background:#e05151"></span>Go back spaces move you backward.</div><div><span style="background:#f0a12d"></span>Lose a turn spaces create a skip.</div><div><span style="background:#3d86f2"></span>Extra roll spaces give another roll.</div><div><span style="background:#f6c344"></span>Finish is space 24.</div></div></section><section class="card"><h2>Leaderboard</h2><div id="leaderboard"></div></section></aside></main></div><div class="toast" id="toast"></div><div class="modal-backdrop" id="modalBackdrop"><div class="modal"><h3>Winner</h3><p id="winnerText">A group reached the finish.</p><button id="closeModal">Close</button></div></div>
<script>
const COLORS={1:'#f26a3d',2:'#f6c344',3:'#31b86b',4:'#4fb7f2',5:'#9b63d8',6:'#ff79b0'};
const E={0:{t:'start'},1:{t:'ahead',a:2,m:'Candy boost. Move ahead 2 spaces.'},2:{t:'ahead',a:2,m:'Sweet shortcut. Move ahead 2 spaces.'},3:{t:'normal'},4:{t:'lose',m:'You took a wrong turn. Lose your next turn.'},5:{t:'lose',m:'You took a wrong turn. Lose your next turn.'},6:{t:'back',a:2,m:'You tripped on gumdrops. Go back 2 spaces.'},7:{t:'normal'},8:{t:'ahead',a:3,m:'You found a candy boost. Move ahead 3 spaces.'},9:{t:'back',a:3,m:'You hit sticky chocolate. Go back 3 spaces.'},10:{t:'extra',m:'Lucky space. Roll again for this group.'},11:{t:'normal'},12:{t:'back',a:3,m:'You got stuck in molasses. Go back 3 spaces.'},13:{t:'normal'},14:{t:'ahead',a:2,m:'Great job. Move ahead 2 spaces.'},15:{t:'lose',m:'You took a wrong turn. Lose your next turn.'},16:{t:'normal'},17:{t:'back',a:2,m:'You slid on frosting. Go back 2 spaces.'},18:{t:'normal'},19:{t:'extra',m:'Bonus space. Roll again for this group.'},20:{t:'ahead',a:3,m:'Almost there. Move ahead 3 spaces.'},21:{t:'normal'},22:{t:'back',a:2,m:'You slipped on chocolate. Go back 2 spaces.'},23:{t:'normal'},24:{t:'finish'}};
const P={0:[22.8,84.8],1:[36.9,84.8],2:[50.7,84.8],3:[64.8,84.8],4:[78.8,84.8],5:[78.8,66.6],6:[64.8,66.6],7:[50.7,66.6],8:[36.9,66.6],9:[22.8,66.6],10:[22.8,48.3],11:[36.9,48.3],12:[50.7,48.3],13:[64.8,48.3],14:[78.8,48.3],15:[78.8,30.1],16:[64.8,30.1],17:[50.7,30.1],18:[36.9,30.1],19:[22.8,30.1],20:[22.8,11.8],21:[36.9,11.8],22:[50.7,11.8],23:[64.8,11.8],24:[78.8,11.8]};
let cls='7th',roll=null,rolling=false,state=load();
function fresh(){return Array.from({length:6},(_,i)=>({id:i+1,space:0,skip:false,done:false,custom:null}))}
function load(){try{let p=JSON.parse(localStorage.rochaCandyRaceState);return {'7th':p['7th']||fresh(),'6th':p['6th']||fresh()}}catch(e){return {'7th':fresh(),'6th':fresh()}}}
function save(){localStorage.rochaCandyRaceState=JSON.stringify(state)}function G(){return state[cls]}function clamp(n){return Math.max(0,Math.min(24,n))}function ord(n){return ['1st','2nd','3rd','4th','5th','6th'][n-1]}
function pos(el,g,i){let x,y;if(g.custom){[x,y]=g.custom}else{[x,y]=P[g.space];let o=[[-1.8,-1.6],[1.8,-1.6],[-1.8,1.6],[1.8,1.6],[0,-2.8],[0,2.8]][i];x+=o[0];y+=o[1]}el.style.left=x+'%';el.style.top=y+'%'}
function renderTokens(){tokensLayer.innerHTML='';G().forEach((g,i)=>{let el=document.createElement('div');el.className='token'+(g.done?' done':'');el.style.background=COLORS[g.id];el.textContent=g.id;let tag=document.createElement('div');tag.className='tag';tag.textContent='Group '+g.id;el.appendChild(tag);pos(el,g,i);drag(el,g.id);tokensLayer.appendChild(el)})}
function renderGroups(){groupsPanel.innerHTML='';G().forEach(g=>{let row=document.createElement('div');row.className='group-row';row.innerHTML=`<div class="dot" style="background:${COLORS[g.id]}"></div><div><div class="group-title"><span>Group ${g.id}</span><span>Space ${g.space}</span></div><div class="group-space">${cls} Grade</div><div class="badges">${g.skip?'<span class="badge skip">SKIP</span>':''}${g.done?'<span class="badge done">DONE</span>':''}</div><div class="actions">${roll?`<button class="btn-apply" data-a="apply" data-id="${g.id}">Apply +${roll}</button>`:''}<button class="btn-step" data-a="step" data-id="${g.id}">Move +1</button><button class="btn-skip" data-a="skip" data-id="${g.id}">${g.skip?'Unskip':'Skip'}</button></div></div>`;groupsPanel.appendChild(row)});groupsPanel.querySelectorAll('button').forEach(b=>b.onclick=groupAction);celebrateBtn.style.display=G().some(g=>g.done)?'block':'none'}
function renderLead(){leaderboard.innerHTML='';[...G()].sort((a,b)=>b.space-a.space||a.id-b.id).forEach((g,i)=>{let r=document.createElement('div');r.className='leader-row';r.innerHTML=`<span>${ord(i+1)} Group ${g.id}</span><span>${g.done?'Done':'Space '+g.space}</span>`;leaderboard.appendChild(r)})}
function render(){renderTokens();renderGroups();renderLead();save()}
function move(g,d){if(g.done)return;g.custom=null;g.space=clamp(g.space+d);effect(g);render()}
function effect(g){let e=E[g.space]||{t:'normal'};if(e.t==='ahead'){g.space=clamp(g.space+e.a);toast(`Group ${g.id}: ${e.m}`);if(g.space===24){g.done=true;winner(g.id)}}else if(e.t==='back'){g.space=clamp(g.space-e.a);toast(`Group ${g.id}: ${e.m}`)}else if(e.t==='lose'){g.skip=true;toast(`Group ${g.id}: ${e.m}`)}else if(e.t==='extra'){toast(`Group ${g.id}: ${e.m}`)}else if(e.t==='finish'){g.done=true;winner(g.id)}if(g.space===24){g.done=true;winner(g.id)}}
function groupAction(ev){let id=+ev.target.dataset.id,a=ev.target.dataset.a,g=G().find(x=>x.id===id);if(a==='apply'){if(g.done)return toast(`Group ${id} is already finished.`);if(g.skip){g.skip=false;toast(`Group ${id} used this turn to remove the SKIP badge.`);return render()}move(g,roll)}if(a==='step')move(g,1);if(a==='skip'){g.skip=!g.skip;toast(`Group ${id} is now ${g.skip?'skipped':'unskipped'}.`);render()}}
function rollDie(){if(rolling)return;rolling=true;die.classList.add('rolling');rollResult.textContent='Rolling...';let n=0,iv=setInterval(()=>{die.textContent=Math.floor(Math.random()*6)+1;if(++n>14){clearInterval(iv);roll=Math.floor(Math.random()*6)+1;die.textContent=roll;die.classList.remove('rolling');rollResult.textContent='Result: '+roll;rolling=false;renderGroups()}},70)}
function drag(el,id){let on=false,b=boardWrap;el.onpointerdown=e=>{on=true;el.classList.add('dragging');el.setPointerCapture(e.pointerId);e.preventDefault()};el.onpointermove=e=>{if(!on)return;let r=b.getBoundingClientRect(),x=Math.max(0,Math.min(100,(e.clientX-r.left)/r.width*100)),y=Math.max(0,Math.min(100,(e.clientY-r.top)/r.height*100));el.style.left=x+'%';el.style.top=y+'%'};el.onpointerup=e=>{if(!on)return;on=false;el.classList.remove('dragging');let r=b.getBoundingClientRect(),x=Math.max(0,Math.min(100,(e.clientX-r.left)/r.width*100)),y=Math.max(0,Math.min(100,(e.clientY-r.top)/r.height*100));G().find(v=>v.id===id).custom=[+x.toFixed(2),+y.toFixed(2)];save()}}
function toast(m){let t=document.getElementById('toast');t.textContent=m;t.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>t.classList.remove('show'),2600)}
function winner(id){winnerText.textContent=`Group ${id} reached Space 24.`;modalBackdrop.classList.add('show')}
rollBtn.onclick=rollDie;die.onclick=rollDie;die.onkeydown=e=>{if(e.key==='Enter'||e.key===' ')rollDie()};resetBtn.onclick=()=>{if(confirm(`Reset all progress for ${cls} Grade?`)){state[cls]=fresh();roll=null;rollResult.textContent='Roll to begin.';die.textContent='1';render();toast(`${cls} Grade has been reset.`)}};document.querySelectorAll('.btn-class').forEach(btn=>btn.onclick=()=>{cls=btn.dataset.class;roll=null;document.querySelectorAll('.btn-class').forEach(b=>b.classList.toggle('active',b===btn));rollResult.textContent='Roll to begin.';die.textContent='1';render()});celebrateBtn.onclick=()=>{let w=G().find(g=>g.done)||[...G()].sort((a,b)=>b.space-a.space)[0];winner(w.id)};closeModal.onclick=()=>modalBackdrop.classList.remove('show');modalBackdrop.onclick=e=>{if(e.target.id==='modalBackdrop')modalBackdrop.classList.remove('show')};render();
</script></body></html>
